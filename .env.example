# Email delivery (Gmail: create an app password; do not use your normal password)
FORECAST_RECIPIENT=krish.28.naidu@gmail.com
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=your-verified-sender@gmail.com

# Use these instead if EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Use these instead if EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Optional WhatsApp delivery through Twilio WhatsApp
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1your-number

# Check every five minutes; the NWS product is normally issued around 7 AM Pacific.
POLL_SECONDS=300
SEND_HOUR=7
STATE_FILE=forecast_state.json
